--             LÓGICA DOS TOGGLES (local)
-- =====================================================
local lagAtivo = false
local noResetAtivo = false
local resetLoop = nil
local graficosAnterior = nil

-- Função para definir qualidade gráfica (0 = mínimo, 10 = máximo)
local function setGraphicsLevel(level)
    local success, err = pcall(function()
        local settings = game:GetService("UserSettings")
        local gameSettings = settings:GetService("UserGameSettings")
        gameSettings.GraphicsQualityLevel = level
    end)
    if not success then
        warn("Não foi possível alterar os gráficos: " .. tostring(err))
    end
end

-- Função que faz o personagem resetar (morrer e renascer)
local function resetPersonagem()
    local player = game.Players.LocalPlayer
    if player and player.Character then
        -- Método suave: quebrar todas as juntas (mata o personagem)
        player.Character:BreakJoints()
    elseif player and not player.Character then
        -- Se já estiver morto, tenta carregar novamente (força respawn)
        player:LoadCharacter()
    end
end

-- Loop de reset contínuo
local function iniciarLoopReset()
    if resetLoop then return end
    resetLoop = task.spawn(function()
        while lagAtivo and not noResetAtivo do
            pcall(resetPersonagem)
            task.wait(0.3) -- espera 0.3 segundos entre cada reset
        end
        resetLoop = nil
    end)
end

local function pararLoopReset()
    if resetLoop then
        task.cancel(resetLoop)
        resetLoop = nil
    end
end

-- Ativar modo "lag" (gráficos no máximo + possível reset)
local function ativarLag()
    if lagAtivo then return end
    lagAtivo = true
    lagToggle.Text = "ATIVADO"
    lagToggle.BackgroundColor3 = Color3.fromRGB(200, 50, 100)
    
    -- Salva configuração gráfica atual (opcional)
    pcall(function()
        local settings = game:GetService("UserSettings")
        local gameSettings = settings:GetService("UserGameSettings")
        graficosAnterior = gameSettings.GraphicsQualityLevel
    end)
    -- Força gráficos no máximo
    setGraphicsLevel(10)
    
    -- Se o noReset estiver desativado, inicia o loop de reset
    if not noResetAtivo then
        iniciarLoopReset()
    end
end

-- Desativar modo "lag" (restaura gráficos e para reset)
local function desativarLag()
    if not lagAtivo then return end
    lagAtivo = false
    lagToggle.Text = "DESATIVADO"
    lagToggle.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    
    -- Restaura gráficos para o valor anterior (ou 5 como fallback)
    if graficosAnterior then
        setGraphicsLevel(graficosAnterior)
    else
        setGraphicsLevel(5)
    end
    
    -- Para o loop de reset
    pararLoopReset()
end

-- Alternar "no reset"
local function alternarNoReset()
    noResetAtivo = not noResetAtivo
    if noResetAtivo then
        noResetToggle.Text = "ATIVADO"
        noResetToggle.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
        -- Se o lag estiver ativo, interrompe o reset imediatamente
        if lagAtivo then
            pararLoopReset()
        end
    else
        noResetToggle.Text = "DESATIVADO"
        noResetToggle.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
        -- Se o lag estiver ativo, retoma o reset
        if lagAtivo then
            iniciarLoopReset()
        end
    end
end

-- Conectar eventos dos botões
lagToggle.MouseButton1Click:Connect(function()
    if lagAtivo then
        desativarLag()
    else
        ativarLag()
    end
end)

noResetToggle.MouseButton1Click:Connect(alternarNoReset)

-- =====================================================
--                 FUNÇÃO DE DRAG (ARRASTAR)
-- =====================================================
local dragging = false
local dragStart = nil
local startPos = nil

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

