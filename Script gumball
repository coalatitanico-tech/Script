        clipboardSuccess = true
    elseif syn and syn.set_clipboard then
        syn.set_clipboard(LINK_DISCORD)
        clipboardSuccess = true
    elseif game:GetService("TenFootInterface") then
        game:GetService("TenFootInterface"):SetClipboard(LINK_DISCORD)
        clipboardSuccess = true
    end
    
    local originalText = discordBtn.Text
    if clipboardSuccess then
        discordBtn.Text = "✓ LINK COPIADO!"
    else
        discordBtn.Text = "✗ ERRO (manual)"
        warn("Link: " .. LINK_DISCORD)
    end
    discordBtn.BackgroundColor3 = Color3.fromRGB(70, 200, 100)
    
    task.wait(1.5)
    discordBtn.Text = originalText
    discordBtn.BackgroundColor3 = Color3.fromRGB(114, 137, 218)
end)

